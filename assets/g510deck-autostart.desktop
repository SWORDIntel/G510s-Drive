[Desktop Entry]
Version=1.0
Type=Application
Name=Logitech G510 Control Deck (C++)
GenericName=G510 Hardware & GamePanel Control Deck
Comment=Start and monitor the FTXUI Logitech G510 control deck
Exec=systemctl --user start g510deck-watchdog.service
Icon=g510deck
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=logitech;g510;g510s;keyboard;rgb;macro;lcd;gamepanel;deck;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=plasma-shell
X-KDE-autostart-phase=2
